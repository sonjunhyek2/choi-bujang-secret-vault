{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {"source":"/api/notes/:id","destination":"/api/notes?id=:id"},
    {"source":"/api/notices/:id","destination":"/api/notices?id=:id"},
    {"source":"/api/devices/:action","destination":"/api/devices?action=:action"},
    {"source":"/api/auth/:action","destination":"/api/auth?action=:action"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://epiirbcbtjvmyewuetkt.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
